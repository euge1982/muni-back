generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityStatus {
  ACTIVE
  FINISHED
}

enum MeetingStatus {
  SCHEDULED
  SUSPENDED
  FINISHED
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  DROPPED
}

enum MaterialType {
  PDF
  IMAGE
  LINK
}

enum EnrollmentDropReason {
  ABSENCES
  ILLNESS
  ADMINISTRATIVE
  OTHER
}

model Activity {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  status          ActivityStatus @default(ACTIVE)
  capacity        Int
  enrollmentStart DateTime
  enrollmentEnd   DateTime
  responsibleId   Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  meetings        Meeting[]
  enrollments     Enrollment[]
  materials       Material[]

  @@map("activities")
}

model Meeting {
  id          Int           @id @default(autoincrement())
  activityId  Int
  dateTime    DateTime
  location    String
  latitude    Decimal       @default(0)
  longitude   Decimal       @default(0)
  allowedRadius Int         @default(100)
  status      MeetingStatus @default(SCHEDULED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  locationId Int?
  meetingLocation MeetingLocation? @relation(fields: [locationId], references: [id])

  activity    Activity      @relation(fields: [activityId], references: [id])
  //attendances Attendance[]

  @@map("meetings")
}

model MeetingLocation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  latitude  Decimal
  longitude Decimal
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetings  Meeting[]

  @@map("meeting_locations")
}

model Enrollment {
  id            Int              @id @default(autoincrement())
  activityId    Int
  participantId Int
  status        EnrollmentStatus @default(ACTIVE)
  absenceCount  Int              @default(0)
  dropReason    EnrollmentDropReason?
  enrolledAt    DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  activity      Activity         @relation(fields: [activityId], references: [id])

  @@unique([activityId, participantId])
  @@map("enrollments")
}

model Material {
  id          Int          @id @default(autoincrement())
  activityId  Int
  name        String
  type        MaterialType
  url         String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  activity    Activity     @relation(fields: [activityId], references: [id])

  @@map("materials")
}
model ProcessedAbsence {
  id           Int      @id @default(autoincrement())
  enrollmentId Int
  sessionId    Int
  processedAt  DateTime @default(now())

  @@unique([enrollmentId, sessionId])
  @@map("processed_absences")
}
